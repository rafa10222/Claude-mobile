{
  "name": "feijoada-motion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render:stories": "remotion render FeijoadaStories out/feijoada-stories.mp4 --codec=h264 --crf=18",
    "render:reels": "remotion render FeijoadaReels out/feijoada-reels.mp4 --codec=h264 --crf=18",
    "render": "npm run render:stories && npm run render:reels"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
